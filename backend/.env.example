PORT=5000
NODE_ENV=development

# MongoDB (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/zinghub

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Secret key used by the admin image manager (#admin page). Use a long random string.
ADMIN_KEY=

# true = reviews appear immediately, false = you approve them first (set isApproved in MongoDB)
REVIEWS_AUTO_APPROVE=true
