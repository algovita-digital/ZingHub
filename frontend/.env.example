# Leave empty in development (Vite proxies /api to localhost:5000).
# In production set to your deployed API, e.g. https://api.yourdomain.com/api
VITE_API_URL=

# WhatsApp number in international format, digits only (example: 919876543210).
# Confirmed orders use it to prefill the customer and order details in WhatsApp.
VITE_WHATSAPP_NUMBER=

VITE_WHATSAPP_FALLBACK=https://walink.me/7obq58
